# 前端数据来源:http=真实后端(默认),mock=本地假数据演示
# 一键切回 Mock:把下一行改成 VITE_API_MODE=mock 后重启 npm run dev
VITE_API_MODE=http

# 后端地址,留空 = 走同源 /api(开发时由 Vite 代理转发给 http://127.0.0.1:3001)
# 如需直连其他地址再填写,例如 VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_API_BASE_URL=

# ---- 真实模型(DeepSeek,步骤2) ----
# Key 获取: https://platform.deepseek.com/api_keys
# 配置方式二选一,环境变量优先:
#   A) 部署环境/Secrets 里设环境变量(推荐,重启服务生效)
#   B) 复制本文件为 .env 并填好(已加入 .gitignore,绝不提交)
# 注意:未配置 Key 时聊天会明确报错"模型未配置",不会伪装成正常回答
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# 单次调用超时毫秒,失败明确报错,可点"重试"(不自动重试,避免重复花钱)
MODEL_TIMEOUT_MS=60000
# 累计 token 上限(prompt+completion);0=不限制。超限即拦并明示
MODEL_BUDGET_TOKENS=0
